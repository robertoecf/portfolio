{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "observability": { "enabled": true }
}
