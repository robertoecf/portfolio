{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "robertoecf.com", "custom_domain": true },
    { "pattern": "robertoecf.com.br", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
